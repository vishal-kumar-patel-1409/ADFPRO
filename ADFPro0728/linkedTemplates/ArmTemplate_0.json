							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "CSV_Metadata",
								"type": "DatasetReference",
								"parameters": {}
							},
							"fieldList": [
